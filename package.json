{
  "name": "query-petruz",
  "version": "1.0.0",
  "description": "Single-user DBA troubleshooting desktop client for JDBC databases.",
  "author": {
    "name": "Luca Petruzziello",
    "email": "luca.petruzziello@example.com"
  },
  "homepage": "https://example.com/query-petruz",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite --config renderer/vite.config.js",
    "dev:electron": "wait-on tcp:5173 && electron .",
    "build": "npm run build:sidecar && npm run build:renderer",
    "build:renderer": "vite build --config renderer/vite.config.js",
    "build:sidecar": "node scripts/run-gradle.cjs prepareSidecarForElectron --console=plain",
    "test:sidecar": "node scripts/run-gradle.cjs test --console=plain",
    "start": "electron .",
    "dist": "npm run build && electron-builder --publish never",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb --publish never",
    "dist:win": "npm run build && electron-builder --win nsis --publish never",
    "dist:mac": "npm run build && electron-builder --mac dmg --publish never"
  },
  "build": {
    "appId": "com.querypetruz.desktop",
    "productName": "Query Petruz",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "scripts/**/*",
      "dist/renderer/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist/sidecar",
        "to": "sidecar"
      }
    ],
    "linux": {
      "category": "Development",
      "maintainer": "Luca Petruzziello <luca.petruzziello@example.com>",
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg"
      ]
    }
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "chart.js": "^4.5.1",
    "clsx": "^2.1.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^3.0.4",
    "jspdf-autotable": "^5.0.2",
    "lucide-react": "^0.344.0",
    "prismjs": "^1.30.0",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "react-simple-code-editor": "^0.14.1",
    "tailwind-merge": "^2.2.1",
    "uuid": "^13.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "concurrently": "^9.1.2",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "vite": "^5.1.6",
    "wait-on": "^8.0.1"
  }
}